.webp","update_time":"2024-07-02T10:01:11","tag":"tag","sort":10000}]}}}},{"column_id":"aacdf30bfd184b28829176c9317c1e13","parent_id":"57b522a4dbed418bbc791d48d1710c6f","site_id":"57c7fc7a00924d1b8113d77d9729d7eb","title_cn":"部门概况","title_en":"introduction","path":"introduction","componentType":"content","children":[],"data":{"column_id":"aacdf30bfd184b28829176c9317c1e13","parent_id":"57b522a4dbed418bbc791d48d1710c6f","site_id":"57c7fc7a00924d1b8113d77d9729d7eb","title_cn":"部门概况","title_en":"introduction","path":"introduction","componentType":"content","children":[],"articles":{"total":1,"list":[{"id":"d0161eafe1ce4f288ca0f90bb1c3e3de","title":"党政办公室","description":"","image_url":"https://www2.sxjzit.edu.cn:8082/zhglxt/profile/upload/2025/04/10/图层 733_20250410202304A005.webp","update_time":"2025-04-10T00:00:00","tag":"","sort":0}]}}},{"column_id":"68b3567f6b404d08a09a1421636fddf9","parent_id":"57b522a4dbed418bbc791d48d1710c6f","site_id":"57c7fc7a00924d1b8113d77d9729d7eb","title_cn":"党建工作","title_en":"party-construction","path":"?toIndex:home=tabs","componentType":"tabs","children":[],"data":{"column_id":"68b3567f6b404d08a09a1421636fddf9","parent_id":"57b522a4dbed418bbc791d48d1710c6f","site_id":"57c7fc7a00924d1b8113d77d9729d7eb","title_cn":"党建工作","title_en":"party-construction","path":"?toIndex:home=tabs","componentType":"tabs-sub","children":{"total":2,"list":[{"id":"c887f6fdd94d4b72829a16905c41d7a3","title_cn":"党建要闻","title_en":"party-news","is_out":1,"href":"?toTabs:party-construction=party-news","image_url":"https://www2.sxjzit.edu.cn:8082/images/no_picture.webp","site_id":"57c7fc7a00924d1b8113d77d9729d7eb","componentType":"","data":{"total":25,"list":[{"id":"5a659ea8da464542bf77c1bf295914d7","title":"党委书记霍世平作团课培训第一讲","description":"为进一步加强我校团员素质培养，让广大优秀青年接受团的基本知识教育，建设一支有信仰、讲政治、重品行、争先锋、守纪律的新时代团员队伍，我校开展了2025年春季学期入团积极分子团课培训，500余名学员线上线下参加培训。","image_url":"https://www2.sxjzit.edu.cn:8082/zhglxt/profile/upload/2025/05/23/blob_20250523120752A053.png","update_time":"2025-05-17T00:00:00","tag":"","sort":0},{"id":"a8ef83c1e4624d9eb672c4d233b3da56","title":"山西日报刊发党委书记霍世平署名文章","description":"2025年5月13日，山西日报刊发党委书记霍世平署名文章《加快推进高校“五育融合”体系建设》。","image_url":"https://www2.sxjzit.edu.cn:8082/zhglxt/profile/upload/2025/05/23/blob_20250523120625A052.png","update_time":"2025-05-13T00:00:00","tag":"","sort":0},{"id":"c5ed5106689f451b965f1c26748d2056","title":"党委书记霍世平讲授形势与政策课","description":"为充分发挥领导干部在思想政治理论学习和教育中的示范带头作用，落实校领导讲思政课制度，坚持思政课建设和党的创新理论武装同步推进，引导学生弘扬科学家精神，推动科技强国建设。4月15日，党委书记霍世平以《加快实现高水平科技自立自强》为题，为计算机科学与技术专业2432Z127、2432Z128、2432Z129班的同学们讲授了一堂精彩的形势与政策课。","image_url":"https://www2.sxjzit.edu.cn:8082/zhglxt/profile/upload/2025/05/23/blob_20250523120430A051.png","update_time":"2025-04-15T00:00:00","tag":"","sort":0},{"id":"6e698cc567ef4f6190980a50dfe228af","title":"校党委举办深入贯彻中央八项规定精神学习教育读书班","description":"4月2日、4月3日，校党委举办深入贯彻中央八项规定精神学习教育读书班。读书班采取个人自学、集中学习和研讨交流相结合的方式进行。4月3日，校党委召开学习教育交流研讨，党委组织部部长、校长助理贾健鹏主持，党委书记霍世平作总结讲话。","image_url":"https://www2.sxjzit.edu.cn:8082/zhglxt/profile/upload/2025/05/23/blob_20250523120225A049.png","update_time":"2025-04-03T00:00:00","tag":"","sort":0},{"id":"70535a2d2d004ec7b5a05facb233ffc3","title":"铸牢中华民族共同体意识，凝聚民族复兴伟业磅礴力量——党委副书记刘继国讲授形势与政策课","description":"为学习贯彻落实习近平总书记关于学校思政课建设的重要指示、全省教育大会精神，充分发挥领导干部在高校思政课建设中的示范引领作用，引导学生进一步了解中华民族发展历史和中华文化，增强爱国情怀和民族自信。12月16日下午，党委副书记刘继国以《铸牢中华民族共同体意识的重大意义与形势任务》为题，为23130241、23130341班的同学们讲授了一堂凝心聚魂的《形势与政策》课。","image_url":"https://www2.sxjzit.edu.cn:8082/zhglxt/profile/upload/2025/05/23/blob_20250523115655A046.png","update_time":"2024-12-16T00:00:00","tag":"","sort":0},{"id":"916e02202aaf46dbbf07bad2c5d8aeb6","title":"学习贯彻党的二十届三中全会精神 投身中国式现代化伟大实践——党委书记霍世平讲授形势与政策课","description":"为学习贯彻落实党的二十届三中全会精神和习近平总书记对学校思政课建设作出的重要指示精神，充分发挥领导干部在思想政治理论学习和教育中的示范带头作用，进一步激发学生学习贯彻全会精神的热情。12月11日上午，党委书记、政府督导专员霍世平为23310141、23310241、23310341班同学们讲授了一堂精彩的形势与政策课。","image_url":"https://www2.sxjzit.edu.cn:8082/zhglxt/profile/upload/2025/05/23/blob_20250523115505A042.png","update_time":"2024-12-11T00:00:00","tag":"","sort":0}]}},{"id":"34d3670b97da4647a1449e50fe96fd16","title_cn":"理论学习","title_en":"theoretical-learning","is_out":1,"href":"?toTabs:party-construction=theoretical-learning","image_url":"https://www2.sxjzit.edu.cn:8082/images/no_picture.webp","site_id":"57c7fc7a00924d1b8113d77d9729d7eb","componentType":"","data":{"total":24,"list":[{"id":"f0925084a0f0414e8aaa8a5c7c1f1219","title":"校党委理论学习中心组举行专题学习会（五月份）","description":"5月21日上午，校党委在五层中会议室举行理论学习中心组专题学习会。本次学习会以学习《求是》杂志发表的习近平总书记重要文章《激励新时代青年在中国式现代化建设中挺膺担当》为第一议题。会上集中学习了《求是》杂志发表的习近平总书记重要文章《加快建设文化强国》；习近平总书记在二十届中共中央政治局第二十次集体学习时的重要讲话精神；习近平总书记在中共中央政治局会议上的重要讲话精神；习近平总书记给谢依特小学戍边支教西部计划志愿者服务队队员的回信精神；习近平总书记赴莫斯科对俄罗斯进行国事访问期间的重要讲话精神；《求是》杂志发表的习近平总书记重要文章《锲而不舍落实中央八项规定精神，以优良党风引领社风民风》等内容。党委书记霍世平主持会议。","image_url":"https://www2.sxjzit.edu.cn:8082/zhglxt/profile/upload/2025/05/23/blob_20250523121859A055.png","update_time":"2025-05-21T00:00:00","tag":"","sort":0},{"id":"124ba20d574443c5899066508e486b80","title":"培育科学精神 共话强国之梦——党委书记霍世平讲授形势与政策课","description":"","image_url":"https://www2.sxjzit.edu.cn:8082/zhglxt/profile/upload/2025/05/12/2f1b045b11ce4cc1bf804d8b44081b6a640 _5__20250512172531A848.jpg","update_time":"2025-04-16T00:00:00","tag":"","sort":0},{"id":"c238aeee4db64cdaa871bee4e2956a21","title":"校党委理论学习中心组（扩大）举行专题学习会","description":"","image_url":"https://www2.sxjzit.edu.cn:8082/zhglxt/profile/upload/2025/05/12/学校新闻_20250512172644A849.png","update_time":"2025-04-10T00:00:00","tag":"","sort":0},{"id":"2503b36034784a61bf264b85183e025e","title":"校党委举办深入贯彻中央八项规定精神学习教育读书班","description":"","image_url":"https://www2.sxjzit.edu.cn:8082/zhglxt/profile/upload/2025/05/12/4-3-八项规定_20250512172740A851.jpg","update_time":"2025-04-03T00:00:00","tag":"","sort":0},{"id":"7c87a60200f443e69dbe8169b772c9c2","title":"我校召开党委（扩大）会议 开展深入贯彻中央八项规定精神学习教育部署会","description":"","image_url":"https://www2.sxjzit.edu.cn:8082/zhglxt/profile/upload/2025/05/12/3月21扩大会议_20250512173037A853.png","update_time":"2025-03-21T00:00:00","tag":"","sort":0},{"id":"eb678b4ff1e2452586