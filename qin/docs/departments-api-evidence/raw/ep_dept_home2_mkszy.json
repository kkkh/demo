{"code":200,"message":"ok","data":{"top_banners":{"title_cn":"college-red","maskSrc":"special_banner_mask","imgSrc":"https://www2.sxjzit.edu.cn:8082/zhglxt/profile/upload/2025/05/19/college-red.webp","href":""},"nav":[{"column_id":"54923a7f067044da8f2bcefcacadc5db","parent_id":"740bfd47f73a440ea2ac00f6912e8032","site_id":"93ef50506d1f4e2a92477a21ecc8b52f","title_cn":"首页","title_en":"home","path":"home","componentType":"","children":[],"data":{"news":{"column_id":"43d355952eb94dfc8a67a0b8ee40c34c","site_id":"93ef50506d1f4e2a92477a21ecc8b52f","title_cn":"新闻动态","title_en":"news","href":"?toIndex:home=news","componentType":"news","articles":{"total":59,"list":[{"id":"e73b3c837c2041d28cd5d58b37d8ba2a","title":"深耕三晋文脉 活化思政课堂","description":"为深入推进“大思政课”建设，充分挖掘山西本土文化蕴含的思政育人元素，推动地域文化资源与思政课程深度融合，提升思政课堂亲和力与实效性，2026年9月17日下午，马克思主义学院在A410会议室组织开展“立足山西本土文化，挖掘思政教育教学资源”专题教研活动。","image_url":"https://www2.sxjzit.edu.cn:8082/zhglxt/profile/userfiles/mkszy/images/1(3).jpg","update_time":"2026-09-17T00:00:00","tag":"","sort":0},{"id":"ee92bb7779d0482c98044f5a2843c6f5","title":"书香润师心 笃学促成长","description":"为持续加强教师理论素养与人文底蕴建设，营造爱读书、善读书、读好书的浓厚教研氛围，推动教师以学促教、以思促行，2026年9月3日下午，马克思主义学院在A410会议室成功开展教师读书分享会。","image_url":"https://www2.sxjzit.edu.cn:8082/zhglxt/profile/userfiles/mkszy/images/%E5%BE%AE%E4%BF%A1%E5%9B%BE%E7%89%87_20260903145703_183_41.jpg","update_time":"2026-09-03T00:00:00","tag":"","sort":0},{"id":"039a989f8c114757bc6cfb432fcb2496","title":"对标指标细拆解 压实责任促提升","description":"为扎实推进本科教育教学合格评估各项筹备工作落地落细，精准对标评估标准、补齐建设短板、夯实办学根基，2026年8月27日下午，马克思主义学院在A410会议室召开迎评促建关键任务分解专题工作会。","image_url":"https://www2.sxjzit.edu.cn:8082/zhglxt/profile/userfiles/mkszy/images/%E5%BE%AE%E4%BF%A1%E5%9B%BE%E7%89%87_20260827151120_92_41.jpg","update_time":"2026-08-27T00:00:00","tag":"","sort":0},{"id":"51c1b689bc8d49568e23373de4c61b81","title":"凝心聚力启新程 严抓细管提质效","description":"为扎实推进新学期教学工作有序开展，进一步规范教学管理、夯实教学秩序、提升育人质量，2026年8月21日下午，马克思主义学院在六层小会议室召开新学期教学工作部署会。","image_url":"https://www2.sxjzit.edu.cn:8082/zhglxt/profile/userfiles/mkszy/images/%E5%BE%AE%E4%BF%A1%E5%9B%BE%E7%89%87_20260824081458_7_75.jpg","update_time":"2026-08-21T00:00:00","tag":"","sort":0},{"id":"7fdfef2379924cb5b3566aab66501738","title":"严抓阅卷规范 细化归档管理","description":"进一步规范期末考核工作流程，压实教学管理责任，保障思政课程考核公平公正、教学资料完整规范，2026年6月30日上午，马克思主义学院在五层中会议室组织全体思政课教师召开期末阅卷、资料归档专项教研活动。","image_url":"https://www2.sxjzit.edu.cn:8082/zhglxt/profile/userfiles/mkszy/images/1(2).jpg","update_time":"2026-06-30T00:00:00","tag":"","sort":0},{"id":"55a97917baa24704872be6d835ed018f","title":"畅谈话思政 聚力促育人——马克思主义学院召开师生座谈会","description":"马克思主义学院组织开展思政课师生专题座谈会，学院专业课教师、各年级学生代表齐聚参会。","image_url":"https://www2.sxjzit.edu.cn:8082/zhglxt/profile/upload/2026/06/05/blob_20260605095144A099.webp","update_time":"2026-06-04T00:00:00","tag":"","sort":0},{"id":"d4cb8bc94409448bba6f0638fb3c3607","title":"深耕思政沃土 荟萃育人匠心——我校第一届思想政治教育工作者教学能力竞赛决赛圆满落幕","description":"为全面贯彻党的二十届四中全会精神和习近平总书记关于教育的重要论述，聚焦立德树人根本任务，切实推动习近平新时代中国特色社会主义思想进教材、进课堂、进头脑，2026年5月14日上午，我校成功举办第一届思想政治教育工作者教学能力竞赛决赛。","image_url":"https://www2.sxjzit.edu.cn:8082/zhglxt/profile/upload/2026/05/20/blob_20260520102528A709.webp","update_time":"2026-05-19T00:00:00","tag":"","sort":0},{"id":"91a15f1f6a764f86bf086797676b1bc4","title":"我校赴晋中学院参加太行精神融入大中小学思政课一体化集体备课活动","description":"5月12日下午，副校长、马克思主义学院院长贾健鹏带队赴晋中学院参加“赓续太行红色血脉 铸牢思政育人根基”太行精神融入大中小学思政课一体化集体备课活动，并主持大学学段集体备课环节。","image_url":"https://www2.sxjzit.edu.cn:8082/zhglxt/profile/upload/2026/05/27/blob_20260527145830A902.webp","update_time":"2026-05-13T00:00:00","tag":"","sort":0}]}},"classic":{"column_id":"5785fab012ae4a5089c38d9b12833b24","site_id":"93ef50506d1f4e2a92477a21ecc8b52f","title_cn":"经典著作","title_en":"classic","href":"?toIndex:home=classic","componentType":"electronic-book","articles":{"total":11,"list":[{"id":"c9f9cca521b340cc84c92138e718c1de","title":"《自然辩证法》节选","description":"《自然辩证法》节选","image_url":"https://www2.sxjzit.edu.cn:8082/zhglxt/profile/upload/2025/04/16/自然辩证法_20250416222537A365.jpeg","update_time":"2024-09-13T00:00:00","tag":"","sort"