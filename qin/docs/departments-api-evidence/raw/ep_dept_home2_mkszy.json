n_id":"0fa97cdc3ca8487bbfc9a17107e81bd1","parent_id":"740bfd47f73a440ea2ac00f6912e8032","site_id":"93ef50506d1f4e2a92477a21ecc8b52f","title_cn":"党建工作","title_en":"party-work","path":"party-work","componentType":"pagination-notice","children":[],"articles":{"total":10,"list":[{"id":"5618a04150474e709a721167d179cb85","title":"我校思想政治教育工作部党支部召开2025年度组织生活会","description":"3月12日，我校思政部党支部召开2025年度组织生活会暨民主评议党员大会。党委书记霍世平，党委委员、副校长、组织部部长贾健鹏以普通党员身份参会并交流发言，会议由马克思主义学院党总支书记许芝铖主持。","image_url":"https://www2.sxjzit.edu.cn:8082/zhglxt/profile/userfiles/mkszy/images/%E5%9B%BE%E7%89%871.png","update_time":"2026-03-12T00:00:00","tag":"","sort":0},{"id":"217bae4a10cf4fdc85a99e92b92eb8c5","title":"马克思主义学院党总支召开干部任命会议","description":"12月4日，马克思主义学院党总支干部任命会议在教学楼五层会议室召开。学校党委副书记、纪委书记刘继国、副校长贾健鹏出席会议，学校全体教职工参加会议。","image_url":"https://www2.sxjzit.edu.cn:8082/images/no_picture.webp","update_time":"2025-12-04T00:00:00","tag":"","sort":0},{"id":"9924bf180f354ff096937544d0be9c20","title":"以思想之光铸魂育人 以党建引领彰显担当","description":"2025年7月1日，思想政治教育工作部党支部凭借卓越的工作成效，荣获 “先进基层党组织” 称号。​","image_url":"https://www2.sxjzit.edu.cn:8082/zhglxt/profile/upload/2025/07/03/blob_20250703222345A348.webp","update_time":"2025-07-01T00:00:00","tag":"","sort":0},{"id":"ce4ff7ae615b49acb823195713fa5f4e","title":"先锋同辉，共铸党魂","description":"思想政治教育工作部党支部孟丕、段媛两位同志凭借突出表现荣获 “优秀共产党员” 称号，为党支部建设和思政教育事业发展树立了标杆。","image_url":"https://www2.sxjzit.edu.cn:8082/zhglxt/profile/upload/2025/07/03/blob_20250703223159A354.webp","update_time":"2025-07-01T00:00:00","tag":"","sort":0},{"id":"759a377c498c4170afe89284a072c1ad","title":"马克思主义学院党总支选举大会顺利召开","description":"2025年4月3日，马克思主义学院党总支选举大会在五层中会议室顺利举行。","image_url":"https://www2.sxjzit.edu.cn:8082/zhglxt/profile/upload/2025/04/16/图片9_20250416185246A175.png","update_time":"2025-04-03T00:00:00","tag":"","sort":0},{"id":"44e4966bd2a94f479330a317d2711d49","title":"学条例、守党纪，深化党纪学习教育 ——思想政治教育工作部党支部党纪学习教育专题党课","description":"为进一步加强党的纪律建设，持续推进党纪学习教育走深走实、取得实效，2024年5月30日下午，思想政治教育工作部党支部邀请党委组织部长贾健鹏在图书馆马列馆开展了党纪学习教育专题党课活动。","image_url":"https://www2.sxjzit.edu.cn:8082/zhglxt/profile/upload/2025/04/16/图片8_20250416185130A174.png","update_time":"2024-05-30T00:00:00","tag":"","sort":0},{"id":"f98770baca114b97834190f67191ac3c","title":"中共山西晋中理工学院思想政治教育工作部党支部党员大会顺利召开","description":"中共山西晋中理工学院思想政治教育工作部党支部党员大会顺利召开。","image_url":"https://www2.sxjzit.edu.cn:8082/zhglxt/profile/upload/2025/04/16/图片4_20250416184534A169.png","update_time":"2024-05-20T00:00:00","tag":"","sort":0},{"id":"48f285cf458e41679c2150f64aeca848","title":"推动学习宣传贯彻习近平总书记重要论述走深走实","description":"2023年11月16日下午，思政部在图书馆马列馆举行主题交流会，深入学习贯彻习近平总书记的重要论述。","image_url":"https://www2.sxjzit.edu.cn:8082/zhglxt/profile/upload/2025/04/16/图片3_20250416184230A162.png","update_time":"2023-11-16T00:00:00","tag":"","sort":0}]}}},{"column_id":"9124486758c24e38b1404cce45814c5b","parent_id":"740bfd47f73a440ea2ac00f6912e8032","site_id":"93ef50506d1f4e2a92477a21ecc8b52f","title_cn":"课程建设","title_en":"curriculum-construction","path":"curriculum-construction","componentType":"tabs","children":[],"data":{"column_id":"9124486758c24e38b1404cce45814c5b","parent_id":"740bfd47f73a440ea2ac00f6912e8032","site_id":"93ef50506d1f4e2a92477a21ecc8b52f","title_cn":"课程建设","title_en":"curriculum-construction","path":"curriculum-construction","componentType":"tabs-sub","children":{"total":2,"list":[{"id":"c1fcd11ef3374c0ea8d5128a095269ea","title_cn":"课程介绍","title_en":"course-introduction","is_out":1,"href":"?toTab:curriculum-construction=course-introduction","image_url":"https://www2.sxjzit.edu.cn:8082/images/no_picture.webp","site_id":"93ef50506d1f4e2a92477a21ecc8b52f","componentType":"","data":{"total":6,"list":[{"id":"ba2280f3d3bb45ee95277d14eafbef63","title":"马克思主义基本原理","description":"《马克思主义基本原理》课程是一门思想政治理论课程。","image_url":"https://www2.sxjzit.edu.cn:8082/zhglxt/profile/upload/2025/04/17/微信图片_20250417101414_20250417102559A392.png","update_time":"2024-10-18T00:00:00","tag":"","sort":1},{"id":"afe2cccade87419189c9d512e24c8599","title":"毛泽东思想和中国特色社会主义理论体系概论","des