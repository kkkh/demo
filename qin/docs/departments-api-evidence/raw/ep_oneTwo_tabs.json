me":"2025-05-15 23:12:25","update_time":"2025-05-15T00:00:00","tag":"","sort":0},{"id":"4bc1d2b6e21f44d1b5812e93bb5d3995","title":"信创与大数据学院：张剑平","description":"","image_url":"https://www2.sxjzit.edu.cn:8082/zhglxt/profile/upload/2025/05/15/3333333333333333333_20250515231054A874.jpg","create_time":"2025-05-15 23:11:17","update_time":"2025-05-15T00:00:00","tag":"","sort":0},{"id":"0b762cae6878443ca22f66fd038676e1","title":"信创与大数据学院：周海英","description":"","image_url":"https://www2.sxjzit.edu.cn:8082/zhglxt/profile/upload/2025/05/15/222222222_20250515230854A871.jpg","create_time":"2025-05-15 23:08:57","update_time":"2025-05-15T00:00:00","tag":"","sort":0},{"id":"3fa2e9e4b80b43d3bcba7d3f4ad2d1cf","title":"信创与大数据学院：袁太生","description":"","image_url":"https://www2.sxjzit.edu.cn:8082/zhglxt/profile/upload/2025/05/15/11111111111111111111_20250515230713A868.png","create_time":"2025-05-15 23:07:17","update_time":"2025-05-15T00:00:00","tag":"","sort":0},{"id":"c3f622d1f17d460d815590913bb65848","title":"信创与大数据学院：杨风","description":"","image_url":"https://www2.sxjzit.edu.cn:8082/zhglxt/profile/upload/2025/05/15/dbced987-d1f9-47de-8571-7f45a7c555ab微信图片_20241212161001_20250515230326A862.jpg","create_time":"2025-05-15 23:03:28","update_time":"2025-05-15T00:00:00","tag":"","sort":0},{"id":"7b8c49ae562e4c9cadaae827f4a83cd0","title":"信创与大数据学院：孙志毅","description":"","image_url":"https://www2.sxjzit.edu.cn:8082/zhglxt/profile/upload/2025/05/15/微信图片_20250515230102_20250515230123A859.png","create_time":"2025-05-15 22:59:00","update_time":"2025-05-15T00:00:00","tag":"","sort":0},{"id":"61b44a90b9204e33802ed582c7f76128","title":"信创与大数据学院：韩燮","description":"","image_url":"https://www2.sxjzit.edu.cn:8082/zhglxt/profile/upload/2025/05/15/5fb2e114-a93c-4aa7-88f7-685af31082b0微信图片_20241212220512_20250515225804A857.jpg","create_time":"2025-05-15 22:56:40","update_time":"2025-05-15T00:00:00","tag":"","sort":0},{"id":"9f0c7f73120f42bd948e1e90840e3f97","title":"信创与大数据学院：孟立凡","description":"","image_url":"https://www2.sxjzit.edu.cn:8082/zhglxt/profile/upload/2025/05/15/微信图片_20250515194504_20250515194525A734.png","create_time":"2025-05-15 19:45:33","update_time":"2025-05-15T00:00:00","tag":"","sort":0}]}},{"id":"817d95c0097911f08df500163e031f40","title_cn":"专业介绍","title_en":"specialty","is_out":1,"href":"?toTab:introduction=specialty","image_url":"https://www2.sxjzit.edu.cn:8082/images/no_picture.webp","site_id":"890cf93e62aa47a0983aa5f551c92e4a","componentType":"","articles":{"total":13,"list":[{"id":"5025ebe37f1d467c9e6309ad20a673f3","title":"物联网工程","description":"本专业将培养具有良好的科学素养和职业道德，并熟悉物联网产业链中标识、感知、处理和信息传送四个环节，掌握通信、射频、无线传感器网络技术，在国民经济各部门和国防工业中能胜任物联网相关技术的研发和应用系统的规划、分析、设计、开发、部署、运行维护等工作的高级工程技术人才。","image_url":"https://www2.sxjzit.edu.cn:8082/zhglxt/profile/upload/2025/05/19/物联网_20250519212019A169.png","create_time":"2025-05-15 22:50:12","update_time":"2025-05-15T00:00:00","tag":"","sort":1},{"id":"ecd052ac2d3a4c4b85f429a307732be5","title":"通信工程","description":"培养适应现代通信技术和区域经济社会发展需要，具有较高文化素质修养、敬业精神和社会责任感，掌握通信系统、通信网络、信号处理等领域的工程基础和专业基础知识，具备从事通信系统、电子信息系统、计算机应用等领域工作的职业能力和综合素质，能在通信及相关领域从事分析设计、应用开发、管理、教学、技术服务等工作的应用型技术人才。","image_url":"https://www2.sxjzit.edu.cn:8082/zhglxt/profile/upload/2025/05/19/通信_20250519212412A170.png","create_time":"2025-05-11 22:43:44","update_time":"2025-05-11T00:00:00","tag":"","sort":2},{"id":"243d8e5c78064296b55040eb4a80b81a","title":"电子信息工程","description":"电子信息工程专业本科学生应掌握扎实的基础理论、专业基础理论和专业知识及基本技能；具有成为高素质、高层次、多样化、创造性人才所具备的人文精神以及人文、社科方面的背景知识；具有国际化视野；具有创新精神；具有提出、解决带有挑战性问题的能力；具有进行有效的交流与团队合作的能力；具有在相关领域跟踪、发展新理论、新知识、新技术的能力；具有从事相关领域的科学研究、技术开发、教育和管理等工作的能力。","image_url":"https://www2.sxjzit.edu.cn:8082/zhglxt/profile/upload/2025/05/19/电子信息工程_20250519212700A171.png","create_time":"2025-05-11 22:42:56","update_time":"2025-05-11T00:00:00","tag":"","sort":3},{"id":"bc377a7a134046539fb8000d4758cb32","title":"智能科学与技术","description":"本专业旨在培养具备坚实的数学、物理、计算机等多学科交叉知识的人才，能够系统掌握智能科学与人工智能技术的基础理论和技能，具备智能信息处理、分析和智能系统集成方面的能力，具备信息获取、传输、处理、优化、控制、组织等过程的相应工程实施能力。最终能够从事智能系统、智能控制、信息处理、决策支持、机器人、智能家居、智能产品等方面的开发设计等工作。","image_url":"https://www2.sxjzit.edu.cn:8082/zhglxt/profile/upload/2025/05/19/智能科学与技术_20250519213008A172.png","create_time":"2025-05-11 22:44:32","update_time":"2025-05-11T00:00:00","tag":"","sort":4},{"id":"c0d78e18c7134202a05f69f5b1845ef3","title":"电子信息科学与技术","description":"本专业立足山西、服务行业、面向全国、以我国“十四五”规划为导向，培养适应现代电子信息技术和区域经济社会发展的需求，具备电子信息系统设计的基本原理、工程技能与研究方法，能够在光电工程、信息与通信工程等相关领域从事开发、工程应用、系统运行、科学研究、经营管理等方面工作的高素质应用型人才。","image_url":"https://www2.sxjzit.edu.cn:8082/zhglxt/profile/upload/2025/05/19/电子信息科学_20250519213202A173.png","create_time":"2025-05-11 22:43:21","update_time":"2025-05-11T00:00:00","tag":"","sort":5},{"id":"12c0ecc0514045dd94d3ef343fa0764b","title":"虚拟现实技术","description":" 本专业旨在培养具备全面素质和专业技能的应用型人才，以适应虚拟现实行业及相关领域的快速发展需求。通过系统的课程学习、实践训练和项目合作，学生将掌握虚拟现实技术的核心知识和应用技能，具有较强的虚拟现实开发与建模能力，能够进行虚拟现实产品的策划、设计、编码、测试、维护和服务等工作。具有较强的外语沟通能力，可从事虚拟现实类软件开发与测试、系统维护和项目管理等工作，并具备创新意识、团队协作精神和国际视野，为未来的职业发展奠定坚实基础。","image_url":"https://www2.sxjzit.edu.cn:8082/zhglxt/profile/upload/2025/05/19/虚拟现实_20250519213353A174.png","create_time":"2025-05-11 22:39:29","update_time":"2025-05-11T00:00:00","tag":"","sort":6},{"id":"30fdd941243540d8b8bebbd039eba5ad","title":"计算机科学与技术（云计算）","description":"本专业旨在培养掌握计算机科学与技术及云计算基本概念、基本原理、基本方法、基本技术等基础理论知识，具备分析解决云计算和大数据领域实际问题和技术的应用能力，可胜任云计算系统规划设计、云计算平台搭建、云计算系统部署与运维、云计算应用开发与服务等岗位工作，以及具备云计算复杂工程问题的研究分析能力和工程实践能力、自我学习能力、团队协作能力、创新意识和国际视野的高素质工程技术人才。","image_url":"https://www2.sxjzit.edu.cn:8082/zhglxt/profile/upload/2025/05/19/云_20250519213540A180.png","create_time":"2025-05-11 22:41:47","update_time":"2025-05-11T00:00:00","tag":"","sort":7},{"id":"3d3b7c5d857f4d9ab7e4323c3a10e305","title":"计算机科学与技术","description":"本专业培养具有正确的世界观、人生观、价值观、德智体美劳全面发展，扎实的硬件、软件方面的知识和技能、创新意识，融知识、能力、素质全面协调发展的人才；培养具有计算思维、系统架构、系统开发与应用能力，具有解决计算机领域复杂系统问题和计算赋能交叉领域工程问题的能力，具有知识自我更新、团队协作和持续创新的能力，具有全面的文化素质、良好的知识结构和较强的适应新环境、新群体的能力，能够适应国家和地方经济社会发展需要的高素质专业技术人才。本科毕业后能在科技、教育、经济和企事业等部门从事研究、教学和管理工作，或从事计算机应用领域的系统设计、开发、维护与管理的应用型工程技术人才。","image_url":"https://www2.sxjzit.edu.cn:8082/zhglxt/profile/upload/2025/05/19/计算机_20250519213727A182.png","create_time":"2025-05-11 22:45:35","update_time":"2025-05-11T00:00:00","tag":"","sort":8},{"id":"95504555650f4349a8106d15d3af59d5","title":"计算机科学与技术（大数据方向）","description":"本专业培养具有爱国情怀、社会担当和创新意识，掌握数学和计算科学的基础知识，熟练掌握大数据采集、处理、分析与应用相关的理论、知识、技能和方法，具有大数据分析、处理、挖掘、可视化、大数据系统集成、管理维护等能力，能在科研、教育、企事业、行政管理等行业领域从事大数据系统开发、应用和管理等相关工作的德智体美劳全面发展的应用型人才。","image_url":"https://www2.sxjzit.edu.cn:8082/zhglxt/profile/upload/2025/05/19/大数据_20250519213929A183.png","create_time":"2025-05-11 22:42:07","update_time":"2025-05-11T00:00:00","tag":"","sort":9},{"id":"d9650b9fca594ba1a5b6017f71bf3aa5","title":"网络工程","description":"网络工程专业在宽口径专业教学的基础上，面向区域社会发展需求，培养热爱祖国，具有良好人文素养、社会责任感和工程职业道德的高素质工程技术人才。本专业培养的学生掌握信息系统安全、网络安全、软件安全与信息内容安全等网络空间安全相关专业知识，能够在信息产业以及其他国民经济部门，从事各类网络空间安全的设备应用、产品研发、信息系统安全设计与分析、网络空间安全技术咨询与评估服务等工作的应用型和设计型的高素质工程技术人才。","image_url":"https://www2.sxjzit.edu.cn:8082/zhglxt/profile/upload/2025/05/19/网络_20250519214137A184.png","create_time":"2025-05-11 22:45:07","update_time":"2025-05-11T00:00:00","tag":"","sort":10}]}}]}},"timestamp":1790737457874,"executeTime":91}