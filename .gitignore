# 「园枢」项目 Git 忽略规则（2026-09-27 仓库重建时制定）

# ---- macOS 系统文件 ----
.DS_Store
.AppleDouble

# ---- Xcode 用户态与构建产物 ----
xcuserdata/
qin/build/
qin/.build/
DerivedData/
*.xcresult

# ---- 历史备份快照（保留在磁盘、不入库；此后以 Git 作为回滚源）----
DesignCode_backup_*/

# ---- 密钥/凭据（严禁入库；微信 AppSecret 等仅存本机）----
.secrets/
qin/.secrets/
*appsecret*

# ---- Python 工具产物（Scripts/ 下取证与护栏脚本的运行残留）----
__pycache__/
*.pyc

# ---- Trae 工作流产物（Plan/Spec 文档：仅存本地，不入库、不推送）----
.trae/